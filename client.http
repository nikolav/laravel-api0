}

###

POST http://localhost:8000/api/graphql
Internal-Auth: -
Accept: application/json
Content-Type: application/json
Authorization: Bearer -

{
  "query": "mutation { collectionBatchUpsert(tag: \"foos\", patches: [{x: \"foo\"}]) }"
}

###

POST http://localhost:8000/api/graphql
Internal-Auth: -
Accept: application/json
Content-Type: application/json
Authorization: Bearer -

{
  "query": "mutation { collectionDropIds(tag: \"foos\", ids: [2, 3]) }"
